# Kiểm tra cú pháp YAML cục bộ sau khi thêm cấu hình AI vào release (20261112-113024, PyYAML, Windows)
.github/workflows/release.yml OK; jobs= ['android'] ; steps= 13
  buoc kiem tra AI: env keys = ['AI_BASE_URL'] ; dung vars.AI_BASE_URL: True
.github/workflows/ci.yml OK; jobs= ['flutter', 'backend'] ; steps= 7
exit=0

$ grep -n GEMINI (workflow + Fastfile + app/lib)
.github/workflows/ci.yml:69:      # Test dùng fake LLM, không cần GEMINI_API_KEY.
